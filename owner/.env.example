# Strava API credentials — copy to .env and fill in.
# NEVER commit .env. Use GitHub Actions Secrets for CI/Pages sync.
#
# Get these from https://www.strava.com/settings/api
# Then run: pnpm run auth

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Optional local override of OAuth redirect (default http://localhost:8787/callback)
# STRAVA_REDIRECT_URI=http://localhost:8787/callback
